         INFOBIP_MESSAGE_DISPATCH ||--o| INFOBIP_MESSAGE_DISPATCH : "retry_of (self FK)"
+        INFOBIP_CUSTOMER_MAPPING ||--o{ INFOBIP_WHATSAPP_TEMPLATE : owns
+        INFOBIP_PHONE_NUMBER ||--o{ INFOBIP_WHATSAPP_TEMPLATE : "registered on sender"
         INFOBIP_CONFIGURATION {
         int Id PK
         string BaseUrl
@@ -487,15 +488,24 @@ mindmap
